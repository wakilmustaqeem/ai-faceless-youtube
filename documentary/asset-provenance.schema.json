{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Documentary Asset Provenance v2",
  "type":"object",
  "required":["assets"],
  "properties":{"assets":{"type":"array","items":{"type":"object","required":["asset_id","type","source","source_type","generation_method","reference","timestamp","verification_status","rights_status","commercial_use_allowed"],"properties":{
    "asset_id":{"type":"string","minLength":2},
    "type":{"enum":["visual","audio","music","voice"]},
    "source":{"type":"string","minLength":2},
    "source_type":{"enum":["original","licensed","public_domain","open_license","generated","reconstructed","third_party"]},
    "generation_method":{"type":"string","minLength":2},
    "reference":{"type":"string","minLength":2},
    "timestamp":{"type":"string","minLength":2},
    "verification_status":{"enum":["verified","flagged","blocked","needs_human_review"]},
    "license":{"type":"string"},
    "rights_status":{"enum":["original","licensed","public_domain","open_license","permission_required","unknown"]},
    "commercial_use_allowed":{"type":"boolean"},
    "attribution_required":{"type":"boolean"},
    "attribution":{"type":"string"}
  }}}}
}
