{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Documentary Evidence Chain v2",
  "type":"object",
  "required":["claims"],
  "properties":{
    "claims":{"type":"array","items":{"type":"object","required":["claim_id","claim","source_ids","evidence","script_refs","voice_refs","visual_refs","timestamp_refs"],"properties":{
      "claim_id":{"type":"string","minLength":2},
      "claim":{"type":"string","minLength":3},
      "source_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
      "evidence":{"type":"array","minItems":1,"items":{"type":"string"}},
      "script_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
      "voice_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
      "visual_refs":{"type":"array","items":{"type":"string"}},
      "timestamp_refs":{"type":"array","items":{"type":"string"}}
    }}}
  }
}
