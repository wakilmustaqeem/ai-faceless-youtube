{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified Long-Form Documentary Episode",
  "type": "object",
  "required": [
    "title",
    "hook",
    "acts",
    "sources"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 10
    },
    "hook": {
      "type": "string",
      "minLength": 50
    },
    "acts": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "text",
          "voice",
          "visual_direction"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 80
          },
          "voice": {
            "enum": [
              "girl",
              "boy"
            ]
          },
          "visual_direction": {
            "type": "string",
            "minLength": 20
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "verification_status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "verification_status": {
            "const": "verified"
          },
          "published_at": {
            "type": "string"
          }
        }
      }
    }
  }
}
